# --- Base de datos (SQLite — sin Docker) ---
DATABASE_URL=sqlite+aiosqlite:///./sira.db
DATABASE_SSL_REQUIRE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- API ---
APP_ENV=development
APP_SECRET_KEY=cambia-esto-en-produccion
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SESSION_DAYS=30
ALLOW_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAIL=admin@sira.local
BOOTSTRAP_ADMIN_PASSWORD=SiraDemo2026!
BOOTSTRAP_ADMIN_NAME=Administrador SIRA

# --- Telegram Bot ---
# Crea el bot con @BotFather y pega el token aquí. Deja vacío para desactivar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alertas SMS con SMS Gateway for Android (Android + SIM) ---
# Mantén SMS_PROVIDER=disabled hasta completar la configuración del modo elegido.
SMS_PROVIDER=disabled
# local: mismo Wi-Fi, sin Internet. cloud: Android remoto con Internet.
# private: servidor SMSGate propio.
SMSGATE_MODE=local
# Local: http://IP_DEL_ANDROID:8080 | Cloud: puede quedar vacío | Private: https://tu-dominio
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Opcional para teléfonos con varias SIM: 1, 2 o 3. Vacío usa la predeterminada.
SMSGATE_SIM_NUMBER=
SMS_TO=+51XXXXXXXXX
SMS_COOLDOWN_MINUTES=60
SMS_NOTIFY_IRRIGATION=true
SMS_NOTIFY_FROST=true
SMS_NOTIFY_TANK_LOW=true

# --- APIs meteorológicas ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
SENAMHI_BASE_URL=https://wis.senamhi.gob.pe/oapi
SENAMHI_VERIFY_SSL=false

# --- Ingest ---
# Token compartido con el ESP32 para autenticar sus POST /ingest
INGEST_API_KEY=cambia-este-token-largo-y-secreto
# Compatibilidad temporal con el simulador anterior. En producción debe ser false.
ALLOW_LEGACY_DEVICE_KEY=true
