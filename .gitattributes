* text=auto

# Código y configuración se mantienen con saltos Unix en CI/Linux.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf

# Lanzadores locales para Windows.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Activos y entregables binarios: nunca normalizar bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.rar binary
*.7z binary
